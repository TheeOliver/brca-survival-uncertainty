# --- Data --------------------------------------------------------------------
# The exact public METABRIC clinical input snapshot is committed under ODbL for
# reproducibility. Keep all other raw and derived patient data ignored.
data/**
!data/**/
!data/**/.gitkeep
!data/raw/CHECKSUMS.sha256
!data/raw/cbioportal_brca_metabric/
!data/raw/cbioportal_brca_metabric/*.json.gz
!data/raw/cbioportal_brca_metabric/PROVENANCE.json

# --- Generated artefacts ------------------------------------------------------
# Everything here is reproducible from code + config + seed. Committing it
# invites stale numbers in the thesis. See docs/experimental-design.md.
outputs/**
!outputs/**/
!outputs/**/.gitkeep

# --- Synthetic test fixture ---------------------------------------------------
# Generated by tests/conftest.py on first run. No .csv ever enters git, so the
# data rule stays absolute (.githooks/pre-commit enforces it).
tests/fixtures/*.csv

# --- Python -------------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Notebooks ----------------------------------------------------------------
.ipynb_checkpoints/

# --- SLURM --------------------------------------------------------------------
slurm-*.out
logs/

# --- Editors / OS -------------------------------------------------------------
.DS_Store
.vscode/
.idea/
